# Credentials -- never commit. Tokens live outside the repo and are read
# from ZERO3_COMMANDER_TOKEN_FILE at runtime.
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/
*token*.txt
*.token

# Atomic-write temporaries. A crashed write must never be committed.
.tmp-*
*.tmp
*.partial

# OS
.DS_Store
Thumbs.db
