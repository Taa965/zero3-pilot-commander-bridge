# Zero3 Commander Bridge -- example environment.
# Copy to .env (git-ignored) or export in your process manager.
# NEVER put a real token in this file or anywhere else in the repository.

# Base URL of the Zero3 Commander Gateway. HTTPS is mandatory.
ZERO3_COMMANDER_BASE_URL=https://commander.example.internal

# Path to a file containing ONLY the machine token. Read at runtime.
# The file lives outside the repository and outside any synced directory.
ZERO3_COMMANDER_TOKEN_FILE=/etc/zero3/commander.token

# Identity this bridge presents in the X-Zero3-Commander-ID header.
ZERO3_COMMANDER_ID=github-bridge

# Optional: explicit CA bundle for environments using a private CA.
# This is the supported way to trust a non-public CA. Disabling TLS
# verification is not supported.
# ZERO3_COMMANDER_CA_BUNDLE=/etc/zero3/ca-bundle.pem

# Optional tuning.
# ZERO3_COMMANDER_TIMEOUT=30
# ZERO3_BRIDGE_ROOT=.
