# Zero3 Pilot Commander Bridge -- example environment.
# Copy to .env (git-ignored) or export in your process manager.
# NEVER put a real token in this file or anywhere else in the repository.

# Base URL of the Zero3 Pilot apps/web service. HTTPS is mandatory.
ZERO3_COMMANDER_BASE_URL=https://pilot.example.internal

# H5 is the default. Use legacy-commander only as a temporary rollback path
# while retiring the former Pilot Dev Executor /api/commander/v1 adapter.
ZERO3_COMMANDER_ADAPTER=h5

# File containing the client bearer token. For H5 this token must match the
# server-side ZERO3_CONTROL_TOKEN_FILE secret. The secret itself stays outside
# this repository and outside synced directories.
ZERO3_COMMANDER_TOKEN_FILE=/etc/zero3-pilot/control.token

# Transport identity retained for audit compatibility. H5 authorizes with the
# bearer token; the legacy adapter also sends X-Zero3-Commander-ID.
ZERO3_COMMANDER_ID=github-bridge

# Optional: explicit CA bundle for a private CA. TLS verification cannot be disabled.
# ZERO3_COMMANDER_CA_BUNDLE=/etc/zero3-pilot/ca-bundle.pem

# Optional tuning.
# ZERO3_COMMANDER_TIMEOUT=30
# ZERO3_BRIDGE_ROOT=.
