{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zero3.commander.capabilities/1.0",
  "title": "Zero3 Pilot Commander Bridge capabilities",
  "description": "Declares what this bridge can actually do so external agents never guess the interface. Capabilities MUST reflect endpoints that exist on the Commander Gateway today, never planned future features.",
  "type": "object",
  "required": ["schema", "commander_protocol", "commands"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "zero3.commander.capabilities/1.0" },
    "commander_protocol": { "type": "string" },
    "bridge_version": { "type": "string" },
    "commands": {
      "type": "object",
      "required": ["execution.submit", "execution.status", "task.cancel", "task.retry", "task.pause", "task.resume"],
      "additionalProperties": false,
      "properties": {
        "execution.submit": { "type": "boolean" },
        "execution.status": { "type": "boolean" },
        "task.cancel": { "type": "boolean" },
        "task.retry": { "type": "boolean" },
        "task.pause": { "type": "boolean" },
        "task.resume": { "type": "boolean" }
      }
    },
    "endpoints": {
      "type": "object",
      "description": "Informational map from enabled capability to the Commander Gateway route that backs it.",
      "additionalProperties": { "type": "string" }
    },
    "limits": {
      "type": "object",
      "additionalProperties": true
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
