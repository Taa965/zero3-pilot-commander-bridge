{
  "schema": "zero3.commander.capabilities/1.0",
  "bridge_version": "0.1.0",
  "commander_protocol": "zero3-pilot-commander-v1/1.0",
  "commands": {
    "execution.submit": true,
    "execution.status": true,
    "task.cancel": false,
    "task.retry": false,
    "task.pause": false,
    "task.resume": false
  },
  "endpoints": {
    "health": "GET /health",
    "execution.submit": "POST /api/control/v1/tasks",
    "execution.status": "GET /api/control/v1/tasks/{task_id}"
  },
  "limits": {
    "max_command_bytes": 4194304,
    "h5_max_task_bytes": 2097152,
    "recent_index_size": 50,
    "terminal_states": [
      "succeeded",
      "failed",
      "cancelled",
      "blocked",
      "outcome_unknown",
      "quarantined"
    ],
    "transport_adapter_default": "h5",
    "legacy_adapter": "legacy-commander"
  },
  "updated_at": "2026-08-30T12:25:00Z"
}
